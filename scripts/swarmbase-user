#!/usr/bin/python3 -I
"""Root-owned sudo entry point. ALWAYS runs as the target caller, never root.

One JSON request on stdin, followed (for launch) by TERM/KILL control lines.
No daemon environment or credentials in argv. No privileged filesystem work.
"""
import ctypes
from contextlib import ExitStack
import json
import os
import pwd
import selectors
import signal
import stat
import subprocess
import sys
import time


LIBC = ctypes.CDLL(None, use_errno=True)
CLONE_NEWUSER = 0x10000000
CLONE_NEWNS = 0x00020000
MS_RDONLY, MS_NOSUID, MS_NODEV, MS_REMOUNT = 1, 2, 4, 32
MS_BIND, MS_REC, MS_PRIVATE = 4096, 16384, 262144
DIR_FLAGS = os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW


def checked(result, action):
    if result != 0:
        error = ctypes.get_errno()
        raise OSError(error, '%s: %s' % (action, os.strerror(error)))


def mount(source, target, flags):
    checked(LIBC.mount(os.fsencode(source) if source else None, os.fsencode(target),
                       None, flags, None), ('remount ' if flags & MS_REMOUNT else 'mount ') + target)


def unshare_mounts():
    uid, gid = os.getuid(), os.getgid()
    # Keep the real uid/gid numbers and the credentials for supplementary
    # workspace groups. Mount authority exists only in the new user namespace.
    checked(LIBC.unshare(CLONE_NEWUSER), 'create private /tmp user namespace')
    for name, value in [('uid_map', f'{uid} {uid} 1'), ('setgroups', 'deny'), ('gid_map', f'{gid} {gid} 1')]:
        with open('/proc/self/' + name, 'w') as f:
            f.write(value)
    checked(LIBC.unshare(CLONE_NEWNS), 'create private /tmp mount namespace')
    mount(None, '/', MS_REC | MS_PRIVATE)


def bind_dir(fd, target, flags=0):
    mount('/proc/self/fd/%d' % fd, target, MS_BIND)
    mount(None, target, MS_BIND | MS_REMOUNT | MS_NOSUID | MS_NODEV | flags)


def scratch_dir(work, name, private=True):
    try:
        os.mkdir(name, 0o700, dir_fd=work)
    except FileExistsError:
        pass  # Other agents of the same run use this directory too.
    fd = os.open(name, DIR_FLAGS, dir_fd=work)
    st = os.fstat(fd)
    if st.st_uid != os.getuid() or (private and st.st_mode & 0o777 != 0o700):
        os.close(fd)
        raise ValueError('unsafe ownership or permissions on run scratch directory: ' + name)
    return fd


def private_tmp(work_dir, root, display):
    x11_path = '/tmp/.X11-unix'
    guest_x11 = None
    # A daemon configured with a local DISPLAY can use the guest's X server.
    # Otherwise, leave /tmp/.X11-unix available for run-local Xvfb.
    if display.startswith((':', 'unix:')):
        try:
            guest_x11 = os.lstat(x11_path)
        except FileNotFoundError:
            pass
        else:
            if (not stat.S_ISDIR(guest_x11.st_mode) or guest_x11.st_uid != 0
                    or (guest_x11.st_mode & 0o022 and not guest_x11.st_mode & stat.S_ISVTX)):
                raise ValueError('guest X11 socket directory must be root-owned and protected')
    unshare_mounts()
    with ExitStack() as cleanup:
        work = os.open(work_dir, DIR_FLAGS)
        cleanup.callback(os.close, work)
        actual = os.readlink('/proc/self/fd/%d' % work)
        if actual != work_dir or not actual.startswith(root.rstrip('/') + '/') or os.fstat(work).st_uid != os.getuid():
            raise ValueError('run work directory must be caller-owned and inside its home root')
        tmp = scratch_dir(work, 'tmp')
        cleanup.callback(os.close, tmp)
        var_tmp = scratch_dir(work, 'var-tmp')
        cleanup.callback(os.close, var_tmp)
        x11 = None
        if guest_x11:
            x11 = os.open(x11_path, DIR_FLAGS)
            cleanup.callback(os.close, x11)
            st = os.fstat(x11)
            if (st.st_dev, st.st_ino) != (guest_x11.st_dev, guest_x11.st_ino):
                raise ValueError('guest X11 socket directory changed during launch')
            # Xvfb may have made this directory sticky and world-writable.
            # Its parent is still accessible only to the caller.
            os.close(scratch_dir(tmp, '.X11-unix', private=False))
        bind_dir(tmp, '/tmp')
        bind_dir(var_tmp, '/var/tmp')
        if x11 is not None:
            bind_dir(x11, '/tmp/.X11-unix', MS_RDONLY)
        # Linux capability ABI v3: header (version, pid), two data words
        # (effective, permitted, inheritable). No namespace caps past setup.
        header = (ctypes.c_uint32 * 2)(0x20080522, 0)
        checked(LIBC.capset(header, (ctypes.c_uint32 * 6)()), 'drop mount capabilities')


def remove_entry(parent, name):
    st = os.stat(name, dir_fd=parent, follow_symlinks=False)
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent)
        return
    fd = os.open(name, DIR_FLAGS, dir_fd=parent)
    try:
        opened = os.fstat(fd)
        identity = (opened.st_dev, opened.st_ino)
        if identity != (st.st_dev, st.st_ino) or opened.st_uid != os.getuid():
            raise ValueError('cleanup directory changed or is not caller-owned: ' + name)
        # Unlink needs write permission on the directory, and listing needs
        # read permission. An O_PATH fd can pin the directory even at mode 000.
        pinned = '/proc/self/fd/%d' % fd
        if opened.st_mode & 0o700 != 0o700:
            os.chmod(pinned, stat.S_IMODE(opened.st_mode) | 0o700)
        for child in os.listdir(pinned):
            try:
                remove_entry(fd, child)
            except FileNotFoundError:
                pass
        current = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if identity != (current.st_dev, current.st_ino):
            raise ValueError('cleanup directory moved: ' + name)
        os.rmdir(name, dir_fd=parent)
    finally:
        os.close(fd)


def remove(path, recreate=False):
    parts = path.split('/')
    if parts[0] != '' or any(p in ('', '.', '..') for p in parts[1:]):
        raise ValueError('cleanup requires a canonical absolute path')
    # Open every ancestor without following symlinks. Keep the final parent
    # pinned for both removal and recreation, even if its pathname changes.
    parent = os.open('/', DIR_FLAGS)
    try:
        try:
            for part in parts[1:-1]:
                child = os.open(part, DIR_FLAGS, dir_fd=parent)
                os.close(parent)
                parent = child
        except FileNotFoundError:
            return False
        if os.readlink('/proc/self/fd/%d' % parent) != os.path.dirname(path):
            raise ValueError('cleanup parent moved: ' + path)
        try:
            remove_entry(parent, parts[-1])
        except FileNotFoundError:
            if not recreate:
                return False
        if recreate:
            os.mkdir(parts[-1], 0o750, dir_fd=parent)
        return True
    finally:
        os.close(parent)


def prepare(files):
    if not files:
        return
    home = files['home']
    # Never reuse state that an earlier agent could have planted.
    os.makedirs(os.path.dirname(home), mode=0o750, exist_ok=True)
    os.mkdir(home, 0o700)
    for name, contents in files['files'].items():
        if '/' in name or name in ('.', '..'):
            raise ValueError('invalid home file name')
        fd = os.open(os.path.join(home, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(contents)


def children():
    """All direct children, including double-forked descendants adopted by us."""
    with open('/proc/self/task/%d/children' % os.getpid()) as f:
        return [int(p) for p in f.read().split()]


def reap_descendants():
    # A subreaper adopts orphaned descendants. Repeatedly kill and reap direct
    # children: as parents die their descendants become our children, even if
    # they escaped the original process group with setsid().
    while True:
        pids = children()
        if not pids:
            return
        for pid in pids:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        while True:
            try:
                if os.waitpid(-1, os.WNOHANG)[0] == 0:
                    break
            except ChildProcessError:
                break
        time.sleep(0.01)


def launch(req, initial_control):
    # Linux PR_SET_CHILD_SUBREAPER, before any child is forked.
    if LIBC.prctl(36, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), 'PR_SET_CHILD_SUBREAPER')
    if LIBC.prctl(38, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), 'PR_SET_NO_NEW_PRIVS')
    prepare(req.get('files'))
    os.umask(0o007)
    # Open first, then validate the actual directory and chdir by fd. An agent
    # changing a symlink while a sibling starts cannot redirect this cwd.
    cwd_fd = os.open(os.path.realpath(req['cwd']), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        cwd = os.readlink('/proc/self/fd/%d' % cwd_fd)
        st = os.fstat(cwd_fd)
        shared = req.get('cwdGid') and st.st_gid == req['cwdGid'] and st.st_gid in os.getgroups() and st.st_mode & stat.S_ISGID and not st.st_mode & 0o007
        if (st.st_uid != os.getuid() and not shared) or not any(
                cwd == root or cwd.startswith(root.rstrip('/') + '/') for root in req['roots']):
            raise ValueError('cwd must be owned by caller and inside its configured roots')
        os.fchdir(cwd_fd)
        env = {k: str(v) for k, v in req['env'].items() if v is not None}
        account = pwd.getpwuid(os.getuid())
        env.update(USER=account.pw_name, LOGNAME=account.pw_name, SHELL='/bin/sh')
        private_tmp(req['workDir'], req['roots'][0], env.get('DISPLAY', ''))
        pinned = '__SWARMBASE_PINNED_CWD__'
        args = [str(cwd_fd) if a == pinned else a for a in req['args']]
        # bwrap mounts the fd's directory, then chdirs inside its new mount
        # namespace. --[ro-]bind-fd validates and closes the fd before the CLI;
        # an ordinary --bind /proc/self/fd/N would leak host-directory access.
        # The CLI uses -C . and never reopens the host cwd by name.
        child = subprocess.Popen([req['command'], *args], env=env, pass_fds=(cwd_fd,) if pinned in req['args'] else (),
                                 stdin=subprocess.PIPE, start_new_session=True)
    finally:
        os.close(cwd_fd)
    # Feed large prompts without blocking the supervisor's control channel.
    import threading
    def feed():
        try:
            child.stdin.write(req['prompt'].encode())
            child.stdin.close()
        except (BrokenPipeError, OSError):
            pass
    threading.Thread(target=feed, daemon=True).start()
    stopping = False
    deadline = None

    def stop(sig, frame=None):
        nonlocal stopping, deadline
        stopping = True
        deadline = time.monotonic() + (0 if sig == signal.SIGKILL else 3)
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    sel = selectors.DefaultSelector()
    sel.register(0, selectors.EVENT_READ)
    if initial_control:
        stop(signal.SIGKILL if b'KILL' in initial_control else signal.SIGTERM)
    try:
        while child.poll() is None and not (stopping and time.monotonic() >= deadline):
            for key, mask in sel.select(0.05):
                line = os.read(0, 4096)
                stop(signal.SIGKILL if not line or b'KILL' in line else signal.SIGTERM)
                if not line:
                    sel.unregister(0)
        code = child.poll()
    finally:
        reap_descendants()
        child.wait()
    return code if code is not None and code >= 0 else 1


def main():
    if os.getuid() == 0:
        raise ValueError('helper must run as a non-root caller: sudo -u <caller>')
    os.umask(0o027)
    # Preserve control bytes coalesced into the same pipe read as the request.
    line = bytearray()
    while b'\n' not in line:
        b = os.read(0, 65536)
        if not b:
            raise ValueError('missing request')
        line.extend(b)
    payload, _, initial_control = line.partition(b'\n')
    req = json.loads(payload)
    op = req['op']
    if op == 'check':
        paths = []
        for p in req['paths']:
            paths.append(dict(path=p, read=os.access(p, os.R_OK), write=os.access(p, os.W_OK),
                              execute=os.access(p, os.X_OK), directory=os.path.isdir(p)))
        bwrap_fd = False
        if req.get('bwrap'):
            try:
                help_text = subprocess.check_output(['/usr/bin/bwrap', '--help'], env={'PATH': '/usr/bin:/bin'}, text=True, timeout=5)
                bwrap_fd = '--bind-fd' in help_text and '--ro-bind-fd' in help_text
            except (OSError, subprocess.SubprocessError):
                pass
        info = dict(uid=os.getuid(), gid=os.getgid(), home=pwd.getpwuid(os.getuid()).pw_dir,
                    groups=os.getgroups(), paths=paths, bwrapFd=bwrap_fd)
        if req.get('privateTmp'):
            unshare_mounts()
            info['privateTmp'] = True
        print(json.dumps(info))
    elif op == 'readAuth':
        fd = os.open(req['path'], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd) as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077 or st.st_size > 1048576:
                raise ValueError('auth must be a private caller-owned regular file under 1 MiB')
            auth = json.load(f)
            if not isinstance(auth, dict):
                raise ValueError('auth must be a JSON object')
            print(json.dumps(auth))
    elif op == 'mkdir':
        os.makedirs(req['path'], mode=0o750, exist_ok=True)
        print('true')
    elif op == 'remove':
        print(json.dumps(remove(req['path'], req.get('recreate', False))))
    elif op == 'launch':
        return launch(req, initial_control)
    else:
        raise ValueError('unknown operation')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:
        print('swarmbase-user: %s' % e, file=sys.stderr)
        sys.exit(1)
